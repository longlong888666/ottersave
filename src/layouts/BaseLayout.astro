---
interface Props {
  title: string;
  description: string;
  faqJsonLd?: string;
}
const { title, description, faqJsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site!);
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OtterSave" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/img/otter-logo-256.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/img/otter-logo-256.png', Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/img/otter-logo-256.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&family=Patrick+Hand&display=swap"
      rel="stylesheet"
    />
    {
      faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd}></script>
    }
  </head>
  <body>
    <header class="sticky top-0 z-20 bg-cream/85 backdrop-blur-md">
      <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <span class="group-hover:scale-105 group-hover:-rotate-3 transition-transform inline-flex drop-shadow-md">
            <img src="/img/otter-logo-256.png" alt="OtterSave — Ollie the otter" width="40" height="40" class="w-10 h-10 rounded-xl object-cover ring-2 ring-white shadow-md" />
          </span>
          <span class="font-display font-bold text-2xl text-coco tracking-tight">OtterSave</span>
        </a>
        <nav class="flex items-center gap-1.5">
          <a href="/" class="px-4 py-2 rounded-full font-bold text-coco-light hover:bg-white hover:text-coco hover:shadow-md transition-all">Tools</a>
          <a href="/about/" class="px-4 py-2 rounded-full font-bold text-coco-light hover:bg-white hover:text-coco hover:shadow-md transition-all">About</a>
          <a href="/contact/" class="px-4 py-2 rounded-full font-bold text-coco-light hover:bg-white hover:text-coco hover:shadow-md transition-all">Contact</a>
        </nav>
      </div>
    </header>
    <main class="max-w-4xl mx-auto px-4 py-8 min-h-[60vh]">
      <slot />
    </main>
    <footer class="max-w-4xl mx-auto px-4 py-10 text-center text-coco-light">
      <div class="flex items-center justify-center gap-2 mb-3">
        <img src="/img/otter-logo-96.png" alt="" width="34" height="34" class="w-[34px] h-[34px] rounded-lg object-cover ring-2 ring-white shadow" />
        <span class="font-display font-bold text-coco text-lg">OtterSave</span>
      </div>
      <p class="font-bold text-sm">&copy; {new Date().getFullYear()} OtterSave · <a href="/privacy-policy/" class="hover:text-coco">Privacy Policy</a> · <a href="/contact/" class="hover:text-coco">Contact</a></p>
      <p class="font-hand text-lg mt-1">Savings, but make it cozy.</p>
    </footer>
  </body>
</html>
