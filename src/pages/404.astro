---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — OtterSave"
  description="This page doesn't exist. Head back to our free savings calculators — the cozy way."
>
  <div class="text-center pt-12 pb-16">
    <span class="woodsign text-sm">404</span>
    <h1 class="font-display font-bold text-4xl md:text-5xl text-coco leading-tight mt-4">
      This page floated away.
    </h1>
    <p class="text-coco-light text-lg md:text-xl mt-4 max-w-lg mx-auto">
      Oops — we couldn't find what you were looking for. But Ollie's still here,
      floating on his savings, ready to help you calculate.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
      <a href="/" class="btn">Back to home</a>
      <a href="/compound-interest-calculator/" class="btn btn-sky">Compound Interest Calculator</a>
    </div>
  </div>
</BaseLayout>
