---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RetirementCalculator from '../../components/RetirementCalculator.astro';
import LeafIcon from '../../components/LeafIcon.astro';
import LongtailInsights from '../../components/LongtailInsights.astro';
import { allRetirementScenarios, relatedRetirementScenarios, type RetirementScenario } from '../../lib/longtail/retirementScenarios';
import { retirementInsight } from '../../lib/longtail/insights';
import { retirementSavings } from '../../lib/calculators/retirement';
import { formatUSD } from '../../lib/calculators/money';

export function getStaticPaths() {
  return allRetirementScenarios().map((scenario) => ({
    params: { slug: scenario.slug },
    props: { scenario },
  }));
}

const { scenario } = Astro.props as { scenario: RetirementScenario };
const r = retirementSavings(scenario.age, scenario.retAge, 0, scenario.monthly, scenario.rate);
const related = relatedRetirementScenarios(scenario);
const insight = retirementInsight(scenario.age, scenario.monthly, scenario.rate);

const faq = [
  {
    q: `How much will I have at 65?`,
    a: `Saving ${formatUSD(scenario.monthly)} a month from age ${scenario.age} to 65 at ${scenario.rate}% projects to about ${formatUSD(r.total)} — enough for roughly ${formatUSD(r.monthlyWithdrawal)} a month under the 4% rule.`,
  },
  {
    q: `How much do I contribute in total?`,
    a: `Over ${scenario.retAge - scenario.age} years you deposit ${formatUSD(scenario.monthly)} × 12 × ${scenario.retAge - scenario.age} = ${formatUSD(r.contributions)}. The rest comes from compounding.`,
  },
  {
    q: `Is starting at ${scenario.age} too late?`,
    a: `No — it's never too late to start. Starting at ${scenario.age} still gives you ${scenario.retAge - scenario.age} years of growth, and this calculator shows exactly what that can become.`,
  },
  {
    q: `What is the 4% rule?`,
    a: `The 4% rule suggests you can safely withdraw 4% of your nest egg each year in retirement. This scenario projects ${formatUSD(r.monthlyWithdrawal)} a month using that rule.`,
  },
];
const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---

<BaseLayout
  title={`${scenario.title} — OtterSave`}
  description={scenario.description}
  faqJsonLd={faqJsonLd}
>
  <nav class="text-sm text-coco-light mb-3">
    <a href="/" class="hover:text-mint-dark">Home</a> <span class="mx-1">·</span>
    <a href="/retirement-savings-calculator/" class="hover:text-mint-dark">Retirement</a> <span class="mx-1">·</span>
    <span class="font-bold text-coco">Age {scenario.age} → 65</span>
  </nav>

  <h1 class="woodsign text-xl md:text-2xl">{scenario.title}</h1>
  <p class="text-coco-light mt-3 text-lg font-body">{scenario.blurb}</p>

  <!-- 答案区 -->
  <div class="card mt-6 bg-white/70">
    <h2 class="hand-title text-2xl flex items-center gap-2 mb-3">
      <LeafIcon size={24} class="text-mint animate-wiggle" />The answer
    </h2>
    <p class="text-coco-light text-lg">
      Saving <strong class="text-coco">{formatUSD(scenario.monthly)}</strong> a month from age{' '}
      <strong class="text-coco">{scenario.age}</strong> to <strong class="text-coco">65</strong> at{' '}
      <strong class="text-coco">{scenario.rate}%</strong> grows to approximately
    </p>
    <div class="text-4xl md:text-5xl font-display font-bold text-mint-dark mt-3">{formatUSD(r.total)}</div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mt-5">
      <div class="bg-cream rounded-2xl p-4 text-center">
        <div class="text-xs text-coco-light font-bold uppercase tracking-wide">Monthly income (4%)</div>
        <div class="text-xl font-display font-bold text-coco mt-1">{formatUSD(r.monthlyWithdrawal)}</div>
      </div>
      <div class="bg-cream rounded-2xl p-4 text-center">
        <div class="text-xs text-coco-light font-bold uppercase tracking-wide">You deposit</div>
        <div class="text-xl font-display font-bold text-coco mt-1">{formatUSD(r.contributions)}</div>
      </div>
      <div class="bg-cream rounded-2xl p-4 text-center col-span-2 md:col-span-1">
        <div class="text-xs text-coco-light font-bold uppercase tracking-wide">Interest earned</div>
        <div class="text-xl font-display font-bold text-mint-dark mt-1">{formatUSD(r.interest)}</div>
      </div>
    </div>
  </div>

  <RetirementCalculator age={scenario.age} retAge={65} savings={0} monthly={scenario.monthly} rate={scenario.rate} />

  <LongtailInsights insight={insight} />

  <!-- FAQ -->
  <section class="mt-10">
    <h2 class="hand-title text-3xl flex items-center gap-2"><LeafIcon size={26} class="text-mint animate-wiggle" />Quick answers</h2>
    {faq.map((f) => (
      <div class="card mt-4">
        <h3 class="hand-title text-xl">{f.q}</h3>
        <p class="text-coco-light mt-1">{f.a}</p>
      </div>
    ))}
  </section>

  <!-- 站内互链 -->
  <section class="mt-10">
    <h2 class="hand-title text-3xl flex items-center gap-2 mb-3"><LeafIcon size={26} class="text-mint animate-wiggle" />Explore more retirement plans</h2>
    <div class="flex flex-wrap gap-3">
      {related.map((s) => (
        <a class="btn btn-sky" href={`/retirement/${s.slug}/`}>Age {s.age} · {formatUSD(s.monthly)}/mo · {s.rate}%</a>
      ))}
    </div>
  </section>

  <nav class="mt-10">
    <h2 class="hand-title text-3xl flex items-center gap-2 mb-3"><LeafIcon size={26} class="text-mint animate-wiggle" />More cozy calculators</h2>
    <div class="flex flex-wrap gap-3">
      <a class="btn" href="/compound-interest-calculator/">Compound Interest</a>
      <a class="btn" href="/savings-goal-calculator/">Savings Goal</a>
      <a class="btn btn-coral" href="/rule-of-72-calculator/">Rule of 72</a>
      <a class="btn btn-butter" href="/investment-return-calculator/">Investment Return</a>
    </div>
  </nav>

  <div class="mt-10 text-center text-coco-light text-sm"><span>Advertisement placeholder</span></div>
</BaseLayout>
