---
import BaseLayout from '../layouts/BaseLayout.astro';

const iconCompound = '<svg viewBox="0 0 48 48" width="30" height="30" aria-hidden="true"><path d="M24 16 C24 7, 13 9, 13 16 C13 20, 18 21, 24 16 Z" fill="#7BAE5B"/><path d="M24 16 C24 7, 35 9, 35 16 C35 20, 30 21, 24 16 Z" fill="#8FC06B"/><rect x="22.7" y="15" width="2.6" height="9" rx="1.3" fill="#5B8C46"/><ellipse cx="24" cy="30" rx="12.5" ry="5" fill="#F7D774" stroke="#D9A93F" stroke-width="2"/><circle cx="24" cy="30" r="3" fill="none" stroke="#E9B93F" stroke-width="1.6"/><ellipse cx="24" cy="35" rx="12.5" ry="5" fill="#FCE79F" stroke="#D9A93F" stroke-width="2"/><circle cx="24" cy="35" r="3" fill="none" stroke="#E9B93F" stroke-width="1.6"/></svg>';
const iconHouse = '<svg viewBox="0 0 48 48" width="30" height="30" aria-hidden="true"><circle cx="36" cy="13" r="4.5" fill="#F7D774" stroke="#D9A93F" stroke-width="1.6"/><path d="M11 25 L24 14 L37 25 Z" fill="#F5AFA4" stroke="#D97763" stroke-width="2.2" stroke-linejoin="round"/><rect x="16" y="25" width="16" height="14" rx="3" fill="#FFF9EA" stroke="#A8783F" stroke-width="2.2"/><rect x="22" y="30" width="4" height="9" rx="1.5" fill="#8B5E34"/><circle cx="18.5" cy="30.5" r="2" fill="#A6D8F0"/><path d="M6 40 Q12 36 18 40 T30 40 T42 40" stroke="#7BAE5B" stroke-width="2.5" fill="none" stroke-linecap="round"/></svg>';
const iconTarget = '<svg viewBox="0 0 48 48" width="30" height="30" aria-hidden="true"><circle cx="24" cy="24" r="14" fill="#A6D8F0" stroke="#6BA9CE" stroke-width="2.4"/><circle cx="24" cy="24" r="8.5" fill="#FFF9EA" stroke="#6BA9CE" stroke-width="1.8"/><path d="M24 16 L26.2 21.8 L32.5 22.4 L27.6 26.6 L29 32.8 L24 29.6 L19 32.8 L20.4 26.6 L15.5 22.4 L21.8 21.8 Z" fill="#F7D774" stroke="#D9A93F" stroke-width="1.6" stroke-linejoin="round"/><circle cx="33" cy="15" r="2.2" fill="#F5AFA4"/><circle cx="16" cy="33" r="1.8" fill="#7BAE5B"/></svg>';
const iconStar = '<svg viewBox="0 0 48 48" width="30" height="30" aria-hidden="true"><path d="M24 5 L27.5 17.5 L40 21 L27.5 24.5 L24 37 L20.5 24.5 L8 21 L20.5 17.5 Z" fill="#F7D774" stroke="#D9A93F" stroke-width="2.2" stroke-linejoin="round"/><circle cx="24" cy="21" r="3.4" fill="#FFF9EA"/><circle cx="37" cy="35" r="3" fill="#F5AFA4"/><circle cx="11" cy="12" r="2.2" fill="#8FC06B"/><path d="M37 6 L38 9.5 L41.5 10.5 L38 11.5 L37 15 L36 11.5 L32.5 10.5 L36 9.5 Z" fill="#A6D8F0" stroke="#6BA9CE" stroke-width="1" stroke-linejoin="round"/></svg>';
const iconArrow = '<svg viewBox="0 0 48 48" width="30" height="30" aria-hidden="true"><rect x="8" y="27" width="7" height="12" rx="3.5" fill="#7BAE5B"/><rect x="19" y="21" width="7" height="18" rx="3.5" fill="#8FC06B"/><rect x="30" y="14" width="7" height="25" rx="3.5" fill="#6FA54F"/><path d="M12 31 L34 12" stroke="#F7D774" stroke-width="3.2" stroke-linecap="round"/><path d="M27 10.5 L36 8.5 L34 17.5 Z" fill="#F7D774" stroke="#D9A93F" stroke-width="1.6" stroke-linejoin="round"/></svg>';

const iconCalc = '<svg viewBox="0 0 48 48" width="24" height="24" aria-hidden="true"><rect x="12" y="6" width="24" height="36" rx="6" fill="#FFF9EA" stroke="#7BAE5B" stroke-width="2.4"/><rect x="16" y="10" width="16" height="6" rx="2" fill="#7BAE5B"/><circle cx="19" cy="22" r="2.2" fill="#8C6B4A"/><circle cx="24" cy="22" r="2.2" fill="#8C6B4A"/><circle cx="29" cy="22" r="2.2" fill="#8C6B4A"/><circle cx="19" cy="29" r="2.2" fill="#F5AFA4"/><circle cx="24" cy="29" r="2.2" fill="#F5AFA4"/><circle cx="29" cy="29" r="2.2" fill="#F5AFA4"/><circle cx="19" cy="36" r="2.2" fill="#A6D8F0"/><circle cx="24" cy="36" r="2.2" fill="#A6D8F0"/><circle cx="29" cy="36" r="2.2" fill="#A6D8F0"/></svg>';
const iconOtter = '<svg viewBox="0 0 48 48" width="24" height="24" aria-hidden="true"><circle cx="24" cy="26" r="14" fill="#8C6B4A"/><circle cx="17" cy="17" r="4.5" fill="#8C6B4A"/><circle cx="31" cy="17" r="4.5" fill="#8C6B4A"/><circle cx="17" cy="17" r="2" fill="#FFF1D6"/><circle cx="31" cy="17" r="2" fill="#FFF1D6"/><ellipse cx="24" cy="30" rx="9" ry="7" fill="#FFF1D6"/><path d="M18 27.5 Q20 25.5 22 27.5 M26 27.5 Q28 25.5 30 27.5" stroke="#4A3620" stroke-width="2" fill="none" stroke-linecap="round"/><ellipse cx="24" cy="28.5" rx="3" ry="2.2" fill="#4A3620"/><ellipse cx="19.5" cy="32" rx="2.6" ry="1.8" fill="#F5AFA4"/><ellipse cx="28.5" cy="32" rx="2.6" ry="1.8" fill="#F5AFA4"/></svg>';
const iconLock = '<svg viewBox="0 0 48 48" width="24" height="24" aria-hidden="true"><rect x="13" y="21" width="22" height="19" rx="6" fill="#F7D774" stroke="#D9A93F" stroke-width="2.4"/><path d="M17 21 V15 a7 7 0 0 1 14 0 V21" fill="none" stroke="#D9A93F" stroke-width="3.4"/><circle cx="24" cy="29" r="3.2" fill="#FFF9EA"/><rect x="22.4" y="29" width="3.2" height="6" rx="1.6" fill="#FFF9EA"/></svg>';

const tools = [
  { href: '/retirement-savings-calculator/', title: 'Retirement Savings', desc: 'Project your nest egg and 4% income.', icon: iconHouse, ring: 'bg-sky' },
  { href: '/savings-goal-calculator/', title: 'Savings Goal', desc: 'How long until you reach your target?', icon: iconTarget, ring: 'bg-butter' },
  { href: '/rule-of-72-calculator/', title: 'Rule of 72', desc: 'When will your money double?', icon: iconStar, ring: 'bg-coral' },
  { href: '/investment-return-calculator/', title: 'Investment Return', desc: 'Lump sum vs steady contributions.', icon: iconArrow, ring: 'bg-mint' },
];

const steps = [
  { n: '1', title: 'Pick a calculator', desc: 'Compound interest, retirement, goals — take your pick.', c: 'bg-mint text-white' },
  { n: '2', title: 'Slide in your numbers', desc: 'No jargon. Just how much, how often, and how long.', c: 'bg-sky text-coco' },
  { n: '3', title: 'Watch it grow', desc: 'See the curve, share the card, feel the cozy.', c: 'bg-butter text-coco' },
];
---
<BaseLayout
  title="OtterSave — Cozy Savings Calculators"
  description="Friendly compound interest, retirement, and savings goal calculators. Watch your money grow the cozy way."
>

  <!-- ============ HERO ============ -->
  <section class="text-center pt-6 pb-4">
    <div class="relative inline-block">
      <div class="w-56 h-56 md:w-72 md:h-72 rounded-[2.2rem] overflow-hidden border-[5px] border-white shadow-xl rotate-2 animate-float">
        <img src="/img/mascot-640.png" alt="Ollie the otter floating on his savings" width="640" height="640" class="w-full h-full object-cover" />
      </div>
      <span class="absolute -top-3 -right-3 w-11 h-11 rounded-full bg-butter border-2 border-white shadow-md flex items-center justify-center animate-wiggle">
        <svg viewBox="0 0 48 48" width="22" height="22" aria-hidden="true"><path d="M24 8 L27 19 L38 22 L27 25 L24 36 L21 25 L10 22 L21 19 Z" fill="#6B4F2E"/></svg>
      </span>
      <span class="absolute -bottom-2 -left-4 w-9 h-9 rounded-full bg-mint border-2 border-white shadow-md flex items-center justify-center animate-bob">
        <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true"><circle cx="24" cy="26" r="10" fill="#FFF9EA" stroke="#D9A93F" stroke-width="2.5"/></svg>
      </span>
    </div>

    <span class="woodsign text-sm md:text-base mt-8">Free · Private · Adorable</span>
    <h1 class="font-display font-bold text-4xl md:text-6xl text-coco leading-tight mt-4">
      Savings, but<br class="hidden md:block" /> <span class="text-mint-dark">make it cozy.</span>
    </h1>
    <p class="text-coco-light text-lg md:text-xl mt-4 max-w-xl mx-auto">
      Meet <b class="text-coco">Ollie the Otter</b> — he floats on his savings, holding his favorite shell.
      Our free calculators make money feel like a game: simple, warm, and a little bit adorable.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 mt-7">
      <a href="/compound-interest-calculator/" class="btn">Start calculating</a>
      <a href="#tools" class="btn btn-sky">See the tools</a>
    </div>
  </section>

  <!-- ============ TOOLS ============ -->
  <section id="tools" class="mt-14">
    <div class="text-center mb-7">
      <span class="woodsign text-sm">The tools</span>
      <h2 class="hand-title text-3xl md:text-4xl mt-3">Pick your calculator</h2>
    </div>

    <!-- featured: compound interest -->
    <a href="/compound-interest-calculator/" class="group block rounded-[2rem] overflow-hidden bg-gradient-to-br from-mint to-mint-dark border-2 border-white shadow-lg p-7 md:p-9 hover:-translate-y-1 transition-transform duration-200">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5">
        <div class="flex items-center gap-4">
          <span class="w-14 h-14 shrink-0 rounded-2xl bg-white/90 flex items-center justify-center shadow-md group-hover:scale-110 group-hover:-rotate-6 transition-transform">
            <span set:html={iconCompound}></span>
          </span>
          <div>
            <p class="text-white/80 font-hand text-lg leading-none">⭐ Most popular</p>
            <h3 class="font-display font-bold text-2xl md:text-3xl text-white mt-1">Compound Interest</h3>
            <p class="text-white/85 mt-1">Watch your savings snowball over time.</p>
          </div>
        </div>
        <span class="font-display font-bold text-white text-xl bg-white/20 border-2 border-white/50 rounded-full px-5 py-2.5 inline-flex items-center gap-2 group-hover:bg-white/30 transition-colors">
          Try it <span class="group-hover:translate-x-1 transition-transform">→</span>
        </span>
      </div>
    </a>

    <!-- other 4 tools -->
    <div class="grid gap-5 md:grid-cols-2 mt-5">
      {tools.map(t => (
        <a href={t.href} class="card group hover:-translate-y-1 transition-transform duration-200 block">
          <div class="flex items-center gap-4">
            <span class={`w-14 h-14 shrink-0 rounded-2xl ${t.ring} flex items-center justify-center border-2 border-white shadow group-hover:scale-110 group-hover:-rotate-6 transition-transform`}>
              <span set:html={t.icon} class="drop-shadow-sm"></span>
            </span>
            <div class="flex-1">
              <h3 class="font-display font-bold text-xl text-coco">{t.title}</h3>
              <p class="text-coco-light text-sm mt-0.5">{t.desc}</p>
            </div>
            <span class="font-display font-bold text-mint-dark text-2xl group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="mt-14">
    <div class="text-center mb-7">
      <span class="woodsign text-sm">How it works</span>
      <h2 class="hand-title text-3xl md:text-4xl mt-3">Three tiny steps</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {steps.map(s => (
        <div class="card text-center">
          <span class={`mx-auto w-12 h-12 rounded-full ${s.c} font-display font-bold text-xl flex items-center justify-center border-2 border-white shadow-md`}>{s.n}</span>
          <p class="font-display font-bold text-lg text-coco mt-3">{s.title}</p>
          <p class="text-coco-light text-sm mt-1">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ WHY ============ -->
  <section class="mt-14">
    <div class="text-center mb-7">
      <span class="woodsign text-sm">Why OtterSave?</span>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      <div class="card text-center">
        <div class="mx-auto w-12 h-12 rounded-full bg-mint flex items-center justify-center border-2 border-white shadow-md">
          <span set:html={iconCalc} class="drop-shadow-sm"></span>
        </div>
        <p class="font-display font-bold text-coco mt-3">Accurate math</p>
        <p class="text-sm text-coco-light mt-1">Standard formulas, tested every release.</p>
      </div>
      <div class="card text-center">
        <div class="mx-auto w-12 h-12 rounded-full bg-sky flex items-center justify-center border-2 border-white shadow-md">
          <span set:html={iconOtter} class="drop-shadow-sm"></span>
        </div>
        <p class="font-display font-bold text-coco mt-3">Cozy by design</p>
        <p class="text-sm text-coco-light mt-1">Money feels less scary when it's cute.</p>
      </div>
      <div class="card text-center">
        <div class="mx-auto w-12 h-12 rounded-full bg-butter flex items-center justify-center border-2 border-white shadow-md">
          <span set:html={iconLock} class="drop-shadow-sm"></span>
        </div>
        <p class="font-display font-bold text-coco mt-3">Private by default</p>
        <p class="text-sm text-coco-light mt-1">Everything runs in your browser.</p>
      </div>
    </div>
  </section>
</BaseLayout>
