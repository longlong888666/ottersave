---
import BaseLayout from '../layouts/BaseLayout.astro';
import OtterLogo from '../components/OtterLogo.astro';
import CozyScene from '../components/CozyScene.astro';

const tools = [
  { href: '/compound-interest-calculator/', title: 'Compound Interest', desc: 'See your savings snowball over time.', icon: '🌱', grad: 'from-mint/40 to-mint/10' },
  { href: '/retirement-savings-calculator/', title: 'Retirement Savings', desc: 'Project your nest egg and 4% income.', icon: '🦦', grad: 'from-sky/40 to-sky/10' },
  { href: '/savings-goal-calculator/', title: 'Savings Goal', desc: 'How long until you reach your target?', icon: '🎯', grad: 'from-butter/50 to-butter/15' },
  { href: '/rule-of-72-calculator/', title: 'Rule of 72', desc: 'When will your money double?', icon: '✨', grad: 'from-coral/40 to-coral/10' },
  { href: '/investment-return-calculator/', title: 'Investment Return', desc: 'Lump sum vs steady contributions.', icon: '📈', grad: 'from-mint/40 to-mint/10' },
];
---
<BaseLayout
  title="OtterSave — Cozy Savings Calculators"
  description="Friendly compound interest, retirement, and savings goal calculators. Watch your money grow the cozy way."
>
  <CozyScene />

  <section class="text-center -mt-16 relative z-10 pb-6">
    <div class="animate-float inline-block drop-shadow-lg">
      <OtterLogo size={110} />
    </div>
    <h1 class="font-display text-5xl md:text-6xl font-800 text-coco mt-4 leading-tight">
      Savings, but <span class="text-mint-dark">make it cozy.</span>
    </h1>
    <p class="text-coco-light text-xl mt-3 max-w-xl mx-auto">
      Meet Ollie the Otter. He collects pebbles; you collect savings.
      Our calculators make money feel like a game — simple, warm, and a little bit adorable.
    </p>
  </section>

  <section class="grid gap-5 md:grid-cols-2 mt-6">
    {tools.map(t => (
      <a
        href={t.href}
        class="group card bg-gradient-to-br ${t.grad} hover:scale-[1.03] hover:-translate-y-1 transition-all duration-200 block border-2 border-white/60"
      >
        <div class="flex items-start justify-between">
          <div class="w-14 h-14 rounded-2xl bg-white/80 shadow-sm flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
            {t.icon}
          </div>
          <span class="font-display font-bold text-mint-dark text-lg group-hover:translate-x-1 transition-transform">Try it →</span>
        </div>
        <h2 class="font-display text-2xl font-800 text-coco mt-4">{t.title}</h2>
        <p class="text-coco-light mt-1">{t.desc}</p>
      </a>
    ))}
  </section>

  <section class="mt-12 text-center">
    <p class="font-display text-xl font-800 text-coco">Why OtterSave?</p>
    <div class="grid gap-4 md:grid-cols-3 mt-4 max-w-3xl mx-auto">
      <div class="card bg-white/70">
        <div class="text-3xl">🧮</div>
        <p class="font-bold text-coco mt-2">Accurate math</p>
        <p class="text-sm text-coco-light mt-1">Standard formulas, tested every release.</p>
      </div>
      <div class="card bg-white/70">
        <div class="text-3xl">🦦</div>
        <p class="font-bold text-coco mt-2">Cozy by design</p>
        <p class="text-sm text-coco-light mt-1">Money feels less scary when it's cute.</p>
      </div>
      <div class="card bg-white/70">
        <div class="text-3xl">🔒</div>
        <p class="font-bold text-coco mt-2">Private by default</p>
        <p class="text-sm text-coco-light mt-1">Everything runs in your browser.</p>
      </div>
    </div>
  </section>
</BaseLayout>
