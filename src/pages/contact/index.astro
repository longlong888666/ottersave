---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeafIcon from '../../components/LeafIcon.astro';
---
<BaseLayout
  title="Contact — OtterSave"
  description="Contact OtterSave — we read every message."
>
  <h1 class="woodsign text-xl md:text-2xl">Contact</h1>
  <div class="card mt-6">
    <p class="text-coco-light font-body">Questions, feedback, or spotted a bug? Email us:</p>
    <p class="hand-title text-2xl text-coco mt-3 flex items-center gap-2"><LeafIcon size={22} class="text-mint" />hello@ottersave.com</p>
  </div>
</BaseLayout>
