---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InvestmentReturnCalculator from '../../components/InvestmentReturnCalculator.astro';
import LeafIcon from '../../components/LeafIcon.astro';

const faq = [
  { q: 'What is the difference between lump sum and monthly investing?', a: 'A lump sum starts working immediately; monthly investing (dollar-cost averaging) spreads risk. Both can work well.' },
  { q: 'Does this account for inflation?', a: 'No. Returns are nominal; subtract expected inflation (~2-3%) for a rough real return.' },
];
const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---
<BaseLayout
  title="Investment Return Calculator — OtterSave"
  description="Free investment return calculator: compare lump sum vs monthly investing with compound growth chart."
  faqJsonLd={faqJsonLd}
>
  <h1 class="woodsign text-xl md:text-2xl">Investment Return Calculator</h1>
  <p class="text-coco-light mt-3 text-lg font-body">Lump sum or steady pebbles? See which path grows your pile.</p>

  <InvestmentReturnCalculator />

  <section class="mt-10">
    <h2 class="hand-title text-3xl flex items-center gap-2"><LeafIcon size={26} class="text-mint animate-wiggle" />Investment return FAQ</h2>
    {faq.map(f => (
      <div class="card mt-4"><h3 class="hand-title text-xl">{f.q}</h3><p class="text-coco-light mt-1">{f.a}</p></div>
    ))}
  </section>

  <nav class="mt-10">
    <h2 class="hand-title text-3xl flex items-center gap-2 mb-3"><LeafIcon size={26} class="text-mint animate-wiggle" />More cozy calculators</h2>
    <div class="flex flex-wrap gap-3">
      <a class="btn btn-sky" href="/compound-interest-calculator/">Compound Interest</a>
      <a class="btn" href="/retirement-savings-calculator/">Retirement</a>
      <a class="btn btn-butter" href="/savings-goal-calculator/">Savings Goal</a>
      <a class="btn btn-coral" href="/rule-of-72-calculator/">Rule of 72</a>
    </div>
  </nav>

  <div class="mt-10 text-center text-coco-light text-sm"><span>Advertisement placeholder</span></div>
</BaseLayout>
