---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SavingsGoalCalculator from '../../components/SavingsGoalCalculator.astro';
import LeafIcon from '../../components/LeafIcon.astro';
import LongtailInsights from '../../components/LongtailInsights.astro';
import { allGoalScenarios, relatedGoalScenarios, type GoalScenario } from '../../lib/longtail/savingsGoalScenarios';
import { goalInsight } from '../../lib/longtail/insights';
import { savingsGoal } from '../../lib/calculators/savingsGoal';
import { formatUSD } from '../../lib/calculators/money';

export function getStaticPaths() {
  return allGoalScenarios().map((scenario) => ({
    params: { slug: scenario.slug },
    props: { scenario },
  }));
}

const { scenario } = Astro.props as { scenario: GoalScenario };
const r = savingsGoal(scenario.target, 0, scenario.monthly, scenario.rate);
const related = relatedGoalScenarios(scenario);
const insight = goalInsight(scenario.target, scenario.monthly, scenario.rate);

function fmtK(n: number): string {
  return n >= 1000 ? `$${(n / 1000).toLocaleString()}k` : `$${n}`;
}
const timeText = Number.isFinite(r.months)
  ? r.months < 12
    ? `${r.months} months`
    : `${(r.months / 12).toFixed(1)} years`
  : 'never (keep saving)';

const faq = [
  {
    q: `How long does it take to save ${fmtK(scenario.target)}?`,
    a: `Saving ${formatUSD(scenario.monthly)} a month toward ${fmtK(scenario.target)} at ${scenario.rate}% takes about ${timeText}. That's about ${formatUSD(r.daily)} a day.`,
  },
  {
    q: `How much do I need to save daily?`,
    a: `Your monthly contribution of ${formatUSD(scenario.monthly)} works out to roughly ${formatUSD(r.daily)} per day — a small daily habit that compounds into ${fmtK(scenario.target)}.`,
  },
  {
    q: `Can I reach ${fmtK(scenario.target)} faster?`,
    a: `Yes. Increasing your monthly contribution or earning a higher return shortens the timeline dramatically. Use the calculator below to test different numbers.`,
  },
  {
    q: `Does interest really help that much?`,
    a: `Yes — without any return you'd need ${Math.ceil(scenario.target / scenario.monthly / 12)} years of saving. The ${scenario.rate}% return shortens that to roughly ${timeText}.`,
  },
];
const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---

<BaseLayout
  title={`${scenario.title} — OtterSave`}
  description={scenario.description}
  faqJsonLd={faqJsonLd}
>
  <nav class="text-sm text-coco-light mb-3">
    <a href="/" class="hover:text-mint-dark">Home</a> <span class="mx-1">·</span>
    <a href="/savings-goal-calculator/" class="hover:text-mint-dark">Savings Goal</a> <span class="mx-1">·</span>
    <span class="font-bold text-coco">{fmtK(scenario.target)}</span>
  </nav>

  <h1 class="woodsign text-xl md:text-2xl">{scenario.title}</h1>
  <p class="text-coco-light mt-3 text-lg font-body">{scenario.blurb}</p>

  <!-- 答案区 -->
  <div class="card mt-6 bg-white/70">
    <h2 class="hand-title text-2xl flex items-center gap-2 mb-3">
      <LeafIcon size={24} class="text-mint animate-wiggle" />The answer
    </h2>
    <p class="text-coco-light text-lg">
      Saving <strong class="text-coco">{formatUSD(scenario.monthly)}</strong> a month at{' '}
      <strong class="text-coco">{scenario.rate}%</strong> gets you to{' '}
      <strong class="text-coco">{fmtK(scenario.target)}</strong> in approximately
    </p>
    <div class="text-4xl md:text-5xl font-display font-bold text-mint-dark mt-3">{timeText}</div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mt-5">
      <div class="bg-cream rounded-2xl p-4 text-center">
        <div class="text-xs text-coco-light font-bold uppercase tracking-wide">Per day</div>
        <div class="text-xl font-display font-bold text-coco mt-1">{formatUSD(r.daily)}</div>
      </div>
      <div class="bg-cream rounded-2xl p-4 text-center">
        <div class="text-xs text-coco-light font-bold uppercase tracking-wide">Per month</div>
        <div class="text-xl font-display font-bold text-coco mt-1">{formatUSD(r.monthly)}</div>
      </div>
      <div class="bg-cream rounded-2xl p-4 text-center col-span-2 md:col-span-1">
        <div class="text-xs text-coco-light font-bold uppercase tracking-wide">Worth at finish</div>
        <div class="text-xl font-display font-bold text-mint-dark mt-1">{formatUSD(r.final)}</div>
      </div>
    </div>
  </div>

  <SavingsGoalCalculator target={scenario.target} current={0} monthly={scenario.monthly} rate={scenario.rate} />

  <LongtailInsights insight={insight} />

  <!-- FAQ -->
  <section class="mt-10">
    <h2 class="hand-title text-3xl flex items-center gap-2"><LeafIcon size={26} class="text-mint animate-wiggle" />Quick answers</h2>
    {faq.map((f) => (
      <div class="card mt-4">
        <h3 class="hand-title text-xl">{f.q}</h3>
        <p class="text-coco-light mt-1">{f.a}</p>
      </div>
    ))}
  </section>

  <!-- 站内互链 -->
  <section class="mt-10">
    <h2 class="hand-title text-3xl flex items-center gap-2 mb-3"><LeafIcon size={26} class="text-mint animate-wiggle" />Explore more savings goals</h2>
    <div class="flex flex-wrap gap-3">
      {related.map((s) => (
        <a class="btn btn-sky" href={`/savings-goal/${s.slug}/`}>Save {fmtK(s.target)} · {formatUSD(s.monthly)}/mo</a>
      ))}
    </div>
  </section>

  <nav class="mt-10">
    <h2 class="hand-title text-3xl flex items-center gap-2 mb-3"><LeafIcon size={26} class="text-mint animate-wiggle" />More cozy calculators</h2>
    <div class="flex flex-wrap gap-3">
      <a class="btn" href="/compound-interest-calculator/">Compound Interest</a>
      <a class="btn" href="/retirement-savings-calculator/">Retirement</a>
      <a class="btn btn-coral" href="/rule-of-72-calculator/">Rule of 72</a>
      <a class="btn btn-butter" href="/investment-return-calculator/">Investment Return</a>
    </div>
  </nav>

  <div class="mt-10 text-center text-coco-light text-sm"><span>Advertisement placeholder</span></div>
</BaseLayout>
