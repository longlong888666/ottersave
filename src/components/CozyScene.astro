---
// Cozy island scene — decorative layer, pure SVG (no interaction)
// ACNH-inspired: lush trees, flowers, butterflies, sea and sand
---

<div class="relative h-72 md:h-96 overflow-hidden pointer-events-none select-none" aria-hidden="true">
  <!-- sky -->
  <div class="absolute inset-0 bg-gradient-to-b from-sky/70 via-cream to-cream"></div>

  <!-- sun -->
  <div class="absolute right-10 top-7 w-20 h-20 rounded-full bg-butter/85 animate-float-slow" style="box-shadow: 0 0 60px 20px rgba(246,206,91,0.35)"></div>

  <!-- clouds -->
  <svg class="absolute top-6 left-[6%] w-28 h-18 text-white/85 animate-drift" viewBox="0 0 100 60" fill="currentColor">
    <ellipse cx="30" cy="42" rx="22" ry="14"/>
    <ellipse cx="55" cy="34" rx="26" ry="17"/>
    <ellipse cx="78" cy="44" rx="18" ry="12"/>
  </svg>
  <svg class="absolute top-14 right-[24%] w-24 h-16 text-white/70 animate-drift [animation-delay:-6s]" viewBox="0 0 100 60" fill="currentColor">
    <ellipse cx="30" cy="42" rx="22" ry="14"/>
    <ellipse cx="55" cy="34" rx="26" ry="17"/>
    <ellipse cx="78" cy="44" rx="18" ry="12"/>
  </svg>
  <svg class="absolute top-20 left-[38%] w-20 h-14 text-white/60 animate-drift [animation-delay:-3s]" viewBox="0 0 100 60" fill="currentColor">
    <ellipse cx="30" cy="42" rx="22" ry="14"/>
    <ellipse cx="55" cy="34" rx="26" ry="17"/>
    <ellipse cx="78" cy="44" rx="18" ry="12"/>
  </svg>

  <!-- distant hills -->
  <svg class="absolute bottom-14 left-0 w-full h-40 text-mint/25" viewBox="0 0 800 120" preserveAspectRatio="none" fill="currentColor">
    <path d="M0,120 L0,70 Q100,10 200,55 Q300,95 420,45 Q520,10 640,60 Q720,90 800,50 L800,120 Z"/>
  </svg>
  <svg class="absolute bottom-10 left-0 w-full h-36 text-mint/40" viewBox="0 0 800 110" preserveAspectRatio="none" fill="currentColor">
    <path d="M0,110 L0,60 Q120,15 240,55 Q360,90 480,40 Q600,5 700,55 Q760,80 800,55 L800,110 Z"/>
  </svg>

  <!-- grass ground -->
  <div class="absolute bottom-14 inset-x-0 h-24 bg-gradient-to-t from-mint/45 to-mint/10"></div>

  <!-- ===== trees ===== -->
  <svg class="absolute bottom-24 left-[2%] w-28 h-36 text-mint animate-sway" viewBox="0 0 112 144" fill="none">
    <rect x="50" y="84" width="12" height="58" rx="5" fill="#A8783F"/>
    <ellipse cx="56" cy="60" rx="42" ry="34" fill="#7BAE5B"/>
    <ellipse cx="36" cy="70" rx="26" ry="21" fill="#8FC06B"/>
    <ellipse cx="76" cy="56" rx="26" ry="20" fill="#6FA54F"/>
    <circle cx="48" cy="46" r="4" fill="#F6CE5B" opacity="0.9"/>
    <circle cx="70" cy="66" r="3.5" fill="#F2A6A0" opacity="0.85"/>
  </svg>
  <svg class="absolute bottom-24 left-[16%] w-24 h-32 text-mint animate-sway [animation-delay:-1.2s]" viewBox="0 0 112 144" fill="none">
    <rect x="50" y="84" width="12" height="56" rx="5" fill="#A8783F"/>
    <ellipse cx="56" cy="62" rx="40" ry="32" fill="#6FA54F"/>
    <ellipse cx="40" cy="70" rx="24" ry="20" fill="#7BAE5B"/>
    <ellipse cx="72" cy="58" rx="24" ry="19" fill="#8FC06B"/>
    <circle cx="52" cy="50" r="3.5" fill="#F6CE5B" opacity="0.9"/>
  </svg>
  <svg class="absolute bottom-24 right-[14%] w-28 h-36 text-mint animate-sway [animation-delay:-0.6s]" viewBox="0 0 112 144" fill="none">
    <rect x="50" y="84" width="12" height="58" rx="5" fill="#A8783F"/>
    <ellipse cx="56" cy="60" rx="42" ry="34" fill="#8FC06B"/>
    <ellipse cx="36" cy="70" rx="26" ry="21" fill="#7BAE5B"/>
    <ellipse cx="76" cy="56" rx="26" ry="20" fill="#6FA54F"/>
    <circle cx="64" cy="48" r="4" fill="#F2A6A0" opacity="0.9"/>
  </svg>
  <svg class="absolute bottom-24 right-[2%] w-20 h-28 text-mint animate-sway [animation-delay:-2s]" viewBox="0 0 112 144" fill="none">
    <rect x="50" y="84" width="12" height="52" rx="5" fill="#A8783F"/>
    <ellipse cx="56" cy="64" rx="36" ry="30" fill="#7BAE5B"/>
    <ellipse cx="44" cy="72" rx="22" ry="18" fill="#8FC06B"/>
  </svg>

  <!-- ===== flowers ===== -->
  <svg class="absolute bottom-12 left-[30%] w-7 h-9 animate-wiggle" viewBox="0 0 24 32" fill="none">
    <rect x="11" y="16" width="2.5" height="15" rx="1.2" fill="#5B8C46"/>
    <g fill="#F2A6A0">
      <ellipse cx="12" cy="8" rx="3.2" ry="5.5"/>
      <ellipse cx="7.4" cy="10.6" rx="3.2" ry="5.5" transform="rotate(60 12 8)"/>
      <ellipse cx="12" cy="8" rx="3.2" ry="5.5" transform="rotate(120 12 8)"/>
      <ellipse cx="16.6" cy="10.6" rx="3.2" ry="5.5" transform="rotate(240 12 8)"/>
      <ellipse cx="9" cy="14" rx="3.2" ry="5.5" transform="rotate(300 12 8)"/>
    </g>
    <circle cx="12" cy="8" r="2.4" fill="#F6CE5B"/>
  </svg>
  <svg class="absolute bottom-11 left-[44%] w-6 h-8 animate-wiggle [animation-delay:-1.4s]" viewBox="0 0 24 32" fill="none">
    <rect x="11" y="16" width="2.5" height="15" rx="1.2" fill="#5B8C46"/>
    <g fill="#FFF9EA">
      <ellipse cx="12" cy="8" rx="3" ry="5"/>
      <ellipse cx="7.6" cy="10.4" rx="3" ry="5" transform="rotate(60 12 8)"/>
      <ellipse cx="12" cy="8" rx="3" ry="5" transform="rotate(120 12 8)"/>
      <ellipse cx="16.4" cy="10.4" rx="3" ry="5" transform="rotate(240 12 8)"/>
      <ellipse cx="9" cy="13.6" rx="3" ry="5" transform="rotate(300 12 8)"/>
    </g>
    <circle cx="12" cy="8" r="2.3" fill="#F6CE5B"/>
  </svg>
  <svg class="absolute bottom-12 right-[30%] w-7 h-9 animate-wiggle [animation-delay:-2.2s]" viewBox="0 0 24 32" fill="none">
    <rect x="11" y="16" width="2.5" height="15" rx="1.2" fill="#5B8C46"/>
    <g fill="#A6D8F0">
      <ellipse cx="12" cy="8" rx="3.2" ry="5.5"/>
      <ellipse cx="7.4" cy="10.6" rx="3.2" ry="5.5" transform="rotate(60 12 8)"/>
      <ellipse cx="12" cy="8" rx="3.2" ry="5.5" transform="rotate(120 12 8)"/>
      <ellipse cx="16.6" cy="10.6" rx="3.2" ry="5.5" transform="rotate(240 12 8)"/>
      <ellipse cx="9" cy="14" rx="3.2" ry="5.5" transform="rotate(300 12 8)"/>
    </g>
    <circle cx="12" cy="8" r="2.4" fill="#F6CE5B"/>
  </svg>

  <!-- butterfly -->
  <svg class="absolute top-[24%] right-[30%] w-9 h-9 text-coral animate-flutter" viewBox="0 0 32 32" fill="currentColor">
    <path d="M16 16 C12 9, 5 7, 3 12 C1 17, 6 21, 13 20 Z" fill="#F2A6A0"/>
    <path d="M16 16 C20 9, 27 7, 29 12 C31 17, 26 21, 19 20 Z" fill="#F2A6A0"/>
    <path d="M16 16 C13 21, 8 25, 6 23 C4 21, 8 18, 12 17 Z" fill="#F6CE5B"/>
    <path d="M16 16 C19 21, 24 25, 26 23 C28 21, 24 18, 20 17 Z" fill="#F6CE5B"/>
    <ellipse cx="16" cy="16" rx="1.6" ry="5.5" fill="#6B4F2E"/>
  </svg>

  <!-- sea -->
  <svg class="absolute bottom-6 inset-x-0 h-12 text-sky/80 animate-drift" viewBox="0 0 600 30" preserveAspectRatio="none" fill="currentColor">
    <path d="M0,15 Q50,0 100,15 Q150,30 200,15 Q250,0 300,15 Q350,30 400,15 Q450,0 500,15 Q550,30 600,15 L600,30 L0,30 Z"/>
  </svg>
  <svg class="absolute bottom-2 inset-x-0 h-10 text-sky/60 animate-drift [animation-delay:-4s]" viewBox="0 0 600 24" preserveAspectRatio="none" fill="currentColor">
    <path d="M0,12 Q40,0 80,12 Q120,24 160,12 Q200,0 240,12 Q280,24 320,12 Q360,0 400,12 Q440,24 480,12 Q520,0 560,12 Q600,24 600,12 L600,24 L0,24 Z"/>
  </svg>

  <!-- sand beach -->
  <div class="absolute bottom-0 inset-x-0 h-5 bg-gradient-to-t from-sand to-sand/40"></div>

  <!-- pebbles & coins on the sand -->
  <svg class="absolute bottom-2 left-[20%] w-6 h-5 text-coral/80 animate-bob" viewBox="0 0 32 24" fill="currentColor">
    <ellipse cx="16" cy="12" rx="14" ry="10"/>
  </svg>
  <svg class="absolute bottom-2 left-[26%] w-5 h-4 text-sky/90 animate-bob [animation-delay:-1.5s]" viewBox="0 0 32 24" fill="currentColor">
    <ellipse cx="16" cy="12" rx="14" ry="10"/>
  </svg>
  <svg class="absolute bottom-2 right-[22%] w-6 h-5 text-mint/90 animate-bob [animation-delay:-2.5s]" viewBox="0 0 32 24" fill="currentColor">
    <ellipse cx="16" cy="12" rx="14" ry="10"/>
  </svg>
  <svg class="absolute bottom-3 right-[14%] w-6 h-6 text-butter animate-bob [animation-delay:-3.4s]" viewBox="0 0 28 28" fill="currentColor">
    <circle cx="14" cy="14" r="12"/>
    <circle cx="14" cy="14" r="8" fill="none" stroke="#D9A93F" stroke-width="2.2"/>
  </svg>

  <!-- Ollie the otter, floating in the sea -->
  <svg class="absolute bottom-8 left-[46%] w-16 h-11 animate-bob [animation-delay:-1s]" viewBox="0 0 64 44" fill="none">
    <ellipse cx="32" cy="30" rx="24" ry="10" fill="#8C6B4A"/>
    <circle cx="16" cy="22" r="9" fill="#8C6B4A"/>
    <circle cx="12" cy="19" r="2.4" fill="#4A3620"/>
    <ellipse cx="18" cy="25" rx="5.5" ry="4" fill="#FFF1D6"/>
    <ellipse cx="14" cy="24.5" rx="2.4" ry="1.7" fill="#4A3620"/>
    <path d="M4 22 L9 23.5 M28 18 L34 18 M28 15.5 L34 15.5" stroke="#4A3620" stroke-width="1.6" stroke-linecap="round" opacity="0.7"/>
    <ellipse cx="50" cy="27" rx="7" ry="6.5" fill="#8C6B4A"/>
    <circle cx="52" cy="24" r="2" fill="#4A3620" opacity="0.8"/>
  </svg>
</div>
