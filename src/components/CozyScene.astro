---
// Cozy seaside scene decoration layer — pure decorative SVG (no interaction)
---

<div class="relative h-64 md:h-80 overflow-hidden pointer-events-none select-none" aria-hidden="true">
  <!-- sky gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-sky/60 via-cream to-cream"></div>

  <!-- sun -->
  <div class="absolute right-10 top-8 w-20 h-20 rounded-full bg-butter/80 animate-float-slow"></div>

  <!-- clouds -->
  <svg class="absolute top-6 left-[8%] w-24 h-16 text-white/80 animate-drift" viewBox="0 0 100 60" fill="currentColor">
    <ellipse cx="30" cy="42" rx="22" ry="14"/>
    <ellipse cx="55" cy="34" rx="26" ry="17"/>
    <ellipse cx="78" cy="44" rx="18" ry="12"/>
  </svg>
  <svg class="absolute top-16 right-[28%] w-20 h-14 text-white/70 animate-drift [animation-delay:-6s]" viewBox="0 0 100 60" fill="currentColor">
    <ellipse cx="30" cy="42" rx="22" ry="14"/>
    <ellipse cx="55" cy="34" rx="26" ry="17"/>
    <ellipse cx="78" cy="44" rx="18" ry="12"/>
  </svg>

  <!-- distant hill -->
  <svg class="absolute bottom-0 left-0 w-2/3 h-40 text-mint/30" viewBox="0 0 400 120" preserveAspectRatio="none" fill="currentColor">
    <path d="M0,120 L0,70 Q100,10 200,60 Q300,100 400,55 L400,120 Z"/>
  </svg>

  <!-- beach -->
  <div class="absolute bottom-0 inset-x-0 h-16 bg-gradient-to-t from-butter/60 to-butter/20"></div>

  <!-- waves -->
  <svg class="absolute bottom-10 inset-x-0 h-8 text-sky/70 animate-drift" viewBox="0 0 600 30" preserveAspectRatio="none" fill="currentColor">
    <path d="M0,15 Q50,0 100,15 Q150,30 200,15 Q250,0 300,15 Q350,30 400,15 Q450,0 500,15 Q550,30 600,15 L600,30 L0,30 Z"/>
  </svg>
  <svg class="absolute bottom-4 inset-x-0 h-6 text-sky/50 animate-drift [animation-delay:-4s]" viewBox="0 0 600 24" preserveAspectRatio="none" fill="currentColor">
    <path d="M0,12 Q40,0 80,12 Q120,24 160,12 Q200,0 240,12 Q280,24 320,12 Q360,0 400,12 Q440,24 480,12 Q520,0 560,12 Q600,24 600,12 L600,24 L0,24 Z"/>
  </svg>

  <!-- palm/tree on right -->
  <svg class="absolute bottom-6 right-6 w-24 h-32 text-mint-dark animate-sway" viewBox="0 0 100 130" fill="currentColor">
    <rect x="46" y="50" width="8" height="70" rx="4" fill="#5BA887"/>
    <path d="M50,55 Q20,30 8,45 Q25,20 50,45 Q75,20 92,45 Q80,30 50,55 Z" fill="#7BC8A6"/>
  </svg>

  <!-- sprout left -->
  <svg class="absolute bottom-6 left-8 w-10 h-12 text-mint-dark animate-wiggle" viewBox="0 0 40 48" fill="currentColor">
    <rect x="18" y="20" width="4" height="24" rx="2" fill="#5BA887"/>
    <ellipse cx="14" cy="14" rx="10" ry="8" fill="#7BC8A6"/>
    <ellipse cx="26" cy="12" rx="9" ry="7" fill="#A8D8F0"/>
  </svg>

  <!-- pebbles -->
  <svg class="absolute bottom-8 left-1/3 w-8 h-6 text-mint/70 animate-bob" viewBox="0 0 32 24" fill="currentColor">
    <ellipse cx="16" cy="12" rx="14" ry="10"/>
  </svg>
  <svg class="absolute bottom-7 left-[45%] w-6 h-5 text-coral/70 animate-bob [animation-delay:-2s]" viewBox="0 0 32 24" fill="currentColor">
    <ellipse cx="16" cy="12" rx="14" ry="10"/>
  </svg>
  <svg class="absolute bottom-8 left-[55%] w-5 h-4 text-sky/80 animate-bob [animation-delay:-1s]" viewBox="0 0 32 24" fill="currentColor">
    <ellipse cx="16" cy="12" rx="14" ry="10"/>
  </svg>

  <!-- coin -->
  <svg class="absolute bottom-12 left-[62%] w-7 h-7 text-butter animate-bob [animation-delay:-3s]" viewBox="0 0 28 28" fill="currentColor">
    <circle cx="14" cy="14" r="12"/>
    <circle cx="14" cy="14" r="8" fill="none" stroke="#E8B93C" stroke-width="2"/>
  </svg>
</div>
