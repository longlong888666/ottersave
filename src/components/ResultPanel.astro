---
interface Props { results: Record<string, string>; }
const { results } = Astro.props;
const entries = Object.entries(results);
---

<div class="card mt-6 relative overflow-hidden animate-pop-in" aria-live="polite">
  <div id="coin-scatter" class="absolute inset-0 pointer-events-none"></div>
  <div class="flex items-center gap-3 mb-4">
    <span class="w-12 h-12 rounded-full overflow-hidden border-2 border-white shadow-md shrink-0">
      <img src="/img/mascot-96.png" alt="Ollie the otter" width="48" height="48" class="w-full h-full object-cover" />
    </span>
    <div>
      <h2 class="hand-title text-2xl leading-none">Your cozy results</h2>
      <p class="text-coco-light text-sm mt-1">Ollie approves!</p>
    </div>
  </div>
  <dl class="space-y-3">
    {entries.map(([label, value]) => (
      <div class="flex items-center justify-between border-b-2 border-dashed border-mint/30 pb-2">
        <dt class="text-coco-light font-bold">{label}</dt>
        <dd class="font-display text-xl font-700 text-mint-dark">{value}</dd>
      </div>
    ))}
  </dl>
  <div class="mt-4">
    <canvas id="share-canvas" width="1080" height="1080" class="hidden"></canvas>
    <button type="button" id="share-btn" class="btn btn-sky">Share this</button>
  </div>
</div>

<script>
  import { scatterCoins } from './CoinScatter';
  import { renderShareCard } from './ShareCard';

  const shareBtn = document.getElementById('share-btn') as HTMLButtonElement | null;
  const canvas = document.getElementById('share-canvas') as HTMLCanvasElement | null;
  if (shareBtn && canvas) {
    // Astro bundles <script> as module: document.currentScript is null there,
    // so always locate the card from a DOM node we actually hold.
    const panel = shareBtn.closest('.card') as HTMLElement | null;
    if (panel) {
      const scatter = () => {
        scatterCoins(panel.querySelector('#coin-scatter') as HTMLElement);
      };
      scatter();
      // The result box starts hidden; re-scatter the coins the moment it
      // becomes visible so the pop-and-fade plays when the user sees it.
      const host = (panel.closest('#results') || panel.parentElement) as HTMLElement | null;
      if (host && typeof MutationObserver !== 'undefined') {
        const ob = new MutationObserver(() => {
          if (!host.classList.contains('hidden')) scatter();
        });
        ob.observe(host, { attributes: true, attributeFilter: ['class'] });
      }
    }

    shareBtn.addEventListener('click', () => {
      const rows: [string, string][] = [];
      panel?.querySelectorAll('dt, dd').forEach((el, i) => {
        const isDt = i % 2 === 0;
        if (isDt) rows.push([el.textContent?.trim() ?? '', '']);
        else rows[rows.length - 1][1] = el.textContent?.trim() ?? '';
      });
      renderShareCard(canvas, { title: 'My savings', rows }, () => {
        canvas.toBlob((blob) => {
          if (!blob) return;
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'ottersave-share.png';
          a.click();
          URL.revokeObjectURL(url);
        });
      });
    });
  }
</script>
