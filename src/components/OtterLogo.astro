---
interface Props { size?: number; }
const { size = 48 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 100 100" role="img" aria-label="Ollie the otter on a leaf" class="shrink-0">
  <!-- leaf -->
  <path d="M50 92 C 24 78, 8 60, 8 36 C 8 18, 20 8, 33 8 C 41 8, 47 12, 50 17 C 53 12, 59 8, 67 8 C 80 8, 92 18, 92 36 C 92 60, 76 78, 50 92 Z"
        fill="#7BAE5B" stroke="#5B8C46" stroke-width="3" stroke-linejoin="round"/>
  <!-- leaf vein -->
  <path d="M50 20 L50 78 M50 34 L30 22 M50 34 L70 22 M50 48 L26 42 M50 48 L74 42"
        stroke="#CBE6B4" stroke-width="3" stroke-linecap="round" opacity="0.9"/>
  <!-- otter ears -->
  <circle cx="36" cy="37" r="5.5" fill="#6FA54F"/>
  <circle cx="64" cy="37" r="5.5" fill="#6FA54F"/>
  <circle cx="36" cy="37" r="2.4" fill="#FFF1D6"/>
  <circle cx="64" cy="37" r="2.4" fill="#FFF1D6"/>
  <!-- face -->
  <ellipse cx="50" cy="50" rx="18" ry="16" fill="#FFF1D6"/>
  <!-- eyes -->
  <circle cx="42" cy="48" r="3" fill="#4A3620"/>
  <circle cx="58" cy="48" r="3" fill="#4A3620"/>
  <circle cx="43" cy="47" r="1" fill="#ffffff"/>
  <circle cx="59" cy="47" r="1" fill="#ffffff"/>
  <!-- muzzle -->
  <ellipse cx="50" cy="57" rx="9.5" ry="7" fill="#F2C9A6"/>
  <!-- nose -->
  <ellipse cx="50" cy="53.5" rx="3.6" ry="2.6" fill="#4A3620"/>
  <!-- whiskers -->
  <path d="M31 55 L42 56 M69 55 L58 56 M33 63 L43 60.5 M67 63 L57 60.5" stroke="#4A3620" stroke-width="1.6" stroke-linecap="round" opacity="0.75"/>
  <!-- cheeks -->
  <ellipse cx="39" cy="56" rx="3" ry="2" fill="#F2A6A0" opacity="0.65"/>
  <ellipse cx="61" cy="56" rx="3" ry="2" fill="#F2A6A0" opacity="0.65"/>
</svg>
